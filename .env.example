# Origin of the auth server (Render). Server-side only — used both to validate
# sessions and as the target of the /api/auth/* rewrite in next.config.ts.
AUTH_URL=https://sukhan-yhww.onrender.com

# Leave UNSET when proxying (the default). The browser then calls this app's
# own origin and the session cookie stays first-party.
# Set it only when the auth server is reached directly on a shared parent
# domain, e.g. https://auth.yourdomain.com
# NEXT_PUBLIC_AUTH_URL=
