# ---------------------------------------------------------------------------
# Sukhan auth server (Render)
# Copy to server/.env for local development. Never commit the filled-in file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Neon Postgres
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# Public origin of THIS server
BETTER_AUTH_URL=http://localhost:3001
# Public origin of the Next.js frontend
APP_URL=http://localhost:3000

# Comma-separated extra origins allowed to send credentialed requests
TRUSTED_ORIGINS=

# PRODUCTION ONLY. Parent domain shared by the frontend and this server, so the
# browser keeps the session cookie across both. Leave empty in development.
#   frontend  https://sukhan.example.com   (Vercel)
#   auth      https://auth.example.com     (Render)
#   COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# SMTP (Gmail requires an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com
